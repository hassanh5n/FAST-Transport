# Built by the research hub; rebuilt from the files in research/ on demand.
hub/_site/
hub/_site_new/
hub/_logs/
# Per-job intermediates of the rerouting runs; the published results are runs.jsonl and summary.json.
results/*/work/
results/*/logs/
# OSRM map files copied from WSL (hundreds of MB); only the README and the copy script are tracked.
map/*
!map/README.md
!map/copy_from_wsl.sh
