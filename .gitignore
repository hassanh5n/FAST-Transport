node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/dev-dist/
frontend/.cache/
*.tsbuildinfo
.eslintcache
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vercel

