# =====================
# Secrets and local config
# =====================
# Every .env variant (root .env, frontend/.env.local, .env.production, ...) holds keys:
# DATABASE_*, DJANGO_SECRET_KEY, OPENWEBNINJA_API_KEY, MAPBOX_ACCESS_TOKEN,
# VITE_GOOGLE_MAPS_API_KEY, VITE_MAPBOX_TOKEN. A committed example is fine.
.env
.env.*
*.local
!.env.example
!**/.env.example

# =====================
# Backend - Django / Python
# =====================
backend/venv/
backend/.venv/
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.sqlite3
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
backend/staticfiles/
backend/media/

# Database dumps and backups: they contain student, staff and driver records.
# (backups/db_backup_2026-10-12_before_fall2026.json and fasttransport_dump.dump were
# committed before this rule; ignoring does not untrack them - see `git rm --cached`.)
backups/
*.dump
*.sql
*.sql.gz

